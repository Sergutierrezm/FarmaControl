<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.farmacontrol.controller.MenuController">

    <Label fx:id="lblBienvenida"/>

    <Button text="Productos" onAction="#abrirProductos"/>
    <Button text="Facturas"/>
    <Button fx:id="btnUsuarios" text="Usuarios"/>
    <Button text="Cerrar sesión" onAction="#cerrarSesion"/>

</VBox>