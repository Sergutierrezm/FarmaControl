<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.farmacontrol.controller.UsuarioController">

    <!-- TABLA -->
    <top>
        <VBox spacing="10" alignment="CENTER">

            <Label text="GESTIÓN DE USUARIOS"/>

            <TableView fx:id="tablaUsuarios" prefHeight="250">

                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
                    <TableColumn fx:id="colRol" text="Rol" prefWidth="120"/>
                </columns>

            </TableView>

        </VBox>
    </top>

    <!-- FORMULARIO -->
    <center>
        <VBox spacing="10" alignment="CENTER">

            <TextField fx:id="txtNombre" promptText="Nombre"/>
            <TextField fx:id="txtEmail" promptText="Email"/>
            <PasswordField fx:id="txtPassword" promptText="Contraseña"/>

            <ComboBox fx:id="cbRol" promptText="Selecciona rol"/>

        </VBox>
    </center>

    <!-- BOTONES -->
    <bottom>
        <HBox spacing="10" alignment="CENTER">

            <Button text="Guardar" onAction="#guardarUsuario"/>
            <Button text="Eliminar" onAction="#eliminarUsuario"/>
            <Button text="Limpiar" onAction="#limpiarCampos"/>
            <Button text="Volver" onAction="#volverMenu"/>

        </HBox>
    </bottom>

</BorderPane>