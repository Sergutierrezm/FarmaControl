<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        xmlns="http://javafx.com/javafx"
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="com.farmacontrol.controller.ProductoController">

    <!-- PARTE SUPERIOR -->
    <top>
        <VBox spacing="10" alignment="CENTER">

            <Label text="GESTIÓN DE PRODUCTOS"/>

            <TableView fx:id="tablaProductos" prefHeight="300">

                <columns>

                    <TableColumn fx:id="colProveedor" text="Proveedor" prefWidth="180"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="180"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="100"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>
    </top>

    <!-- FORMULARIO -->
    <center>

        <VBox spacing="10" alignment="CENTER">

            <TextField fx:id="txtNombre" promptText="Nombre"/>
            <TextField fx:id="txtDescripcion" promptText="Descripción"/>
            <TextField fx:id="txtPrecio" promptText="Precio"/>
            <TextField fx:id="txtStock" promptText="Stock"/>

            <ComboBox fx:id="cbProveedor" promptText="Selecciona proveedor"/>

        </VBox>

    </center>

    <!-- BOTONES -->
    <bottom>

        <HBox spacing="10" alignment="CENTER">

            <Button text="Guardar" onAction="#guardarProducto"/>
            <Button text="Eliminar" onAction="#eliminarProducto"/>
            <Button text="Volver" onAction="#volverMenu"/>

        </HBox>

    </bottom>

</BorderPane>